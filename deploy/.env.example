# Copy to deploy/.env and fill in. deploy/.env is git-ignored.

# --- venue-hl ---
# Your Hyperliquid account (master) address.
HL_ADDRESS=0x0000000000000000000000000000000000000000
# Read-only works on mainnet. Managed mode must pass on testnet before mainnet.
HL_TESTNET=false
# Alert thresholds.
POLL_SECS=10
LIQ_ALERT_PCT=5
FUNDING_ALERT_APR_PCT=100
ALERT_REPEAT_MINS=30
# Managed mode only (MANAGED=1 make run): host path to a file holding a
# trade-only API (agent) wallet key. Relative paths resolve from deploy/.
HL_AGENT_KEY_HOST_FILE=./secrets/hl_agent_key

# --- gateway ---
# Your numeric Telegram user id (not your @username).
TELEGRAM_OWNER_ID=
# Host path to a file containing the bot token (chmod 600). Never commit it.
TELEGRAM_TOKEN_HOST_FILE=/home/you/.config/perp-vyapari/telegram_token
RUST_LOG=info
